  [$not, and, or, arrow.r, arrow.l.r$], [Отрицание, конъюнкция, включающая дизъюнкция, импликация, эквивалентность.],
  [$equiv$], [Логическая эквивалентность формул.],
  [$models$], [Семантическое следование.],
  [$forall, exists$], [Кванторы всеобщности и существования.],
  [$NN$], [${0, 1, 2, dots}$.],
  [$cal(P)(A)$], [Множество всех подмножеств $A$.],
  [$g compose f$], [Композиция: сначала применяется $f$, затем $g$; тот же порядок для отношений.],
)
